# Copy to .env and fill in. .env is gitignored — the real token must never be committed.
#   cp .env.example .env && nano .env

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user or group id
TELEGRAM_CHAT_ID=

# Minutes between scans. Optional — overrides runtime.interval_minutes in config.json.
EV_HUNTER_INTERVAL_MINUTES=60
